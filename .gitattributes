# Normaliza finales de línea a LF en todo el repo.
# Sin esto, un Windows con core.autocrlf=true ensucia todos los diffs.
* text=auto eol=lf

*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.mp3 binary
*.mp4 binary
*.mov binary
*.woff binary
*.woff2 binary
*.ttf binary

# Los scripts de shell deben conservar LF aunque se editen en Windows.
*.sh text eol=lf
Dockerfile text eol=lf
