# Copia este archivo a .env y rellena lo que tengas.
# La app arranca sin ninguna variable: entra en modo demo (sin login, datos locales).

# --- Base de datos y auth (Supabase) ---
# Sin estas dos, la app corre en modo demo con almacenamiento local en .data/
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Cifrado de las API keys de los usuarios ---
# 32 bytes en base64. Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Sin MASTER_KEY, el guardado de keys queda deshabilitado en modo demo.
MASTER_KEY=

# --- Modelos (IDs en configuración, nunca en el código) ---
GOOGLE_TEXT_MODEL=
GOOGLE_IMAGE_MODEL=
GOOGLE_VIDEO_MODEL=
MINIMAX_SPEECH_MODEL=
MINIMAX_VIDEO_MODEL=
MINIMAX_MUSIC_MODEL=

# --- Worker de render (fase 4) ---
WORKER_URL=
WORKER_SHARED_SECRET=
